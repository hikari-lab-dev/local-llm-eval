{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noParameterAssign": "error",
        "useConst": "error",
        "noUselessElse": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  }
}
